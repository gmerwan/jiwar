DATABASE_URL=postgresql://jiwar:jiwar@localhost:55432/jiwar_dev
PORT=3000
WEB_ORIGIN=http://localhost:5173
MAX_RADIUS_KM=100
DEFAULT_RADIUS_KM=20
PAST_GRACE_HOURS=24
# Signs the anonymous participant cookie, which IS authorship in Jiwar: there are
# no accounts, so this HMAC key is the only thing that stops one browser cancelling
# another's notice. Must be at least 32 characters and must not be left as
# CHANGE_ME — loadConfig() throws on either, so a deployment that forgets this
# fails to boot rather than serving forgeable cookies. Generate one with:
#   openssl rand -base64 48
COOKIE_SECRET=CHANGE_ME
# Marks the participant cookie Secure (HTTPS-only). Defaults to false so local
# dev over plain HTTP keeps working. MUST be set to "true" in any deployment
# served over HTTPS, or the anonymous-identity cookie can be sent over plain HTTP.
# Enforced at startup: loadConfig() throws if WEB_ORIGIN starts with "https://"
# and this is not "true", so a production env that forgets this variable fails
# to boot rather than silently shipping an insecure cookie.
COOKIE_SECURE=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=jiwar-dev/0.1 (local development)
