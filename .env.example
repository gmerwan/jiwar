DATABASE_URL=postgresql://jiwar:jiwar@localhost:55432/jiwar_dev
PORT=3000
WEB_ORIGIN=http://localhost:5173
MAX_RADIUS_KM=100
DEFAULT_RADIUS_KM=20
PAST_GRACE_HOURS=24
COOKIE_SECRET=change-me-in-production-min-32-chars-long
